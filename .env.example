# Connect to database locale avviato tramite docker compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_app?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/order_app?schema=public"

# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# SendGrid API key and support email
SENDGRID_API_KEY="your-sendgrid-api-key"
SUPPORT_EMAIL="support@example.com"

# Shop visibility cutoff (opzionale, default 0)
# Numero di ore (anche negativo) di offset rispetto a "now" per il cutoff di
# visibilità prodotti nello shop (lista + dettaglio). Se non impostata vale 0
# e i prodotti restano visibili fino al momento esatto della consegna.
# Esempi:
#   24  → nascondi tutto ciò che consegna entro 24h (lead time minimo).
#   -24 → mostra anche prodotti scaduti da meno di 24h.
SHOP_HIDE_BEFORE_HOURS="0"
