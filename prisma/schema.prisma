// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-ts"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  password       String?  // Password only for credential-based auth, null for OAuth users
  emailVerified  DateTime?
  image          String?
  role           UserRole @default(NUOVO)
  googleId       String?  @unique
  phoneNumber    String?
  orders         Order[]
  cartItems      CartItem[]
  reservation    CartReservation?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum UserRole {
  NUOVO
  CUSTOMER
  ADMIN
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  price       Float
  sku         String
  image       String?
  deliveryDate DateTime? // Data di consegna prevista; il prezzo è funzione di questa data.
  // Soft-archive: timestamp dell'ultima archiviazione (null = attivo). Il record
  // archiviato è nascosto dallo shop e dalle viste admin di default; restano
  // disponibili gli OrderItem storici grazie agli snapshot. Reversibile.
  archivedAt  DateTime?
  inventory   Inventory?
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reservationItems CartReservationItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, sku])
}

model Inventory {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String  @unique
  quantity  Int     @default(0)
  reserved  Int     @default(0)
  reorderPoint Int  @default(5)
}

model CartItem {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id])
  userId          String
  status          OrderStatus @default(IN_ATTESA)
  address         String      // Shipping address
  notes           String?     // Note opzionali
  paymentMethod   PaymentMethods @default(CASH)
  stripePaymentId String?
  // Soft-archive: vedi commento su Product.archivedAt. L'archiviazione di un
  // Order non tocca lo status né l'inventory: è puramente UX (nascondere
  // dalle view di default). Un ordine ANNULLATO archiviato resta annullato.
  archivedAt      DateTime?
  items           OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  IN_ATTESA
  CONFERMATO
  SPEDITO
  PAGATO_DA_CONSEGNARE
  CONSEGNATO_DA_PAGARE
  CONSEGNATO_E_PAGATO
  ANNULLATO
}

enum PaymentMethods { 
  CASH
  PAYPAL
  STRIPE
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id])
  orderId      String
  product      Product @relation(fields: [productId], references: [id])
  productId    String
  productName  String  // Snapshot del productName al momento dell'ordine
  quantity     Int // Snapshot della quantity al momento dell'ordine
  price        Float // Snapshot del price al momento dell'ordine
}

model CartReservation {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  expiresAt DateTime
  items     CartReservationItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartReservationItem {
  id            String          @id @default(cuid())
  reservation   CartReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String
  product       Product         @relation(fields: [productId], references: [id])
  productId     String
  quantity      Int

  @@unique([reservationId, productId])
}

